# === OmniResearch Environment Configuration ===
# Copy to .env and fill in values

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=omni
POSTGRES_PASSWORD=omni_dev_password
POSTGRES_DB=omniresearch
POSTGRES_MLFLOW_DB=mlflow

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- MinIO / S3 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=omniresearch

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=postgresql://omni:omni_dev_password@localhost:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://omni-mlflow/

# --- LLM ---
LLM_PRIMARY_PROVIDER=fake
LLM_PRIMARY_MODEL=fake-model
# LLM_PRIMARY_API_KEY=  # never commit real keys

# --- Application ---
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development
